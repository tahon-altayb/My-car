<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lBg">

    <!-- خلفية يختارها المستخدم، وفوقها طبقة تعتيم عشان النص يبقى واضح -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/wallpaperScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:background="?attr/lBg"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp">

        <!-- الشريط العلوي: زر الوضع على اليسار والتاريخ على اليمين -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/themeToggle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_tile"
                android:minWidth="150dp"
                android:stateListAnimator="@null"
                android:textColor="?attr/lText"
                android:textSize="18sp" />

            <Button
                android:id="@+id/wallpaperButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_tile"
                android:minWidth="100dp"
                android:stateListAnimator="@null"
                android:text="الخلفية"
                android:textColor="?attr/lText"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:textColor="?attr/lTextDim"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- اليسار: الساعة والسرعة -->
            <LinearLayout
                android:layout_width="210dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/lText"
                    android:textSize="58sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="السرعة"
                        android:textColor="?attr/lTextDim"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/speedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="٠"
                        android:textColor="?attr/lAccent"
                        android:textSize="80sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="كم/س"
                        android:textColor="?attr/lTextDim"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- الوسط: الكاميرا والموسيقى ثم التطبيقات -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3"
                    android:orientation="horizontal">

                    <!-- الطقس ومواقيت الصلاة -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/weatherDesc"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:maxLines="2"
                                android:textColor="?attr/lTextDim"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/weatherTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:textColor="?attr/lText"
                                android:textSize="40sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="?attr/lStroke" />

                        <TextView
                            android:id="@+id/nextPrayerText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="right"
                            android:textColor="?attr/lAccent"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/prayerRow"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- الموسيقى -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:id="@+id/musicInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/musicArt"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_note" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/musicTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:textColor="?attr/lText"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/musicArtist"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:textColor="?attr/lTextDim"
                                    android:textSize="15sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/musicSeek"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="6dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp">

                            <TextView
                                android:id="@+id/musicElapsed"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="?attr/lTextDim"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/musicTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/lTextDim"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/musicPrev"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_round_alt"
                                android:contentDescription="السابق"
                                android:src="@drawable/ic_prev"
                                android:tint="?attr/lText" />

                            <ImageButton
                                android:id="@+id/musicPlay"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_marginLeft="18dp"
                                android:layout_marginRight="18dp"
                                android:background="@drawable/bg_round_accent"
                                android:contentDescription="تشغيل أو إيقاف"
                                android:src="@drawable/ic_play"
                                android:tint="?attr/lOnAccent" />

                            <ImageButton
                                android:id="@+id/musicNext"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_round_alt"
                                android:contentDescription="التالي"
                                android:src="@drawable/ic_next"
                                android:tint="?attr/lText" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- التطبيقات: الخرائط + 3 مربعات يختارها المستخدم -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="14dp"
                    android:layout_weight="2"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/mapsTile"
                        layout="@layout/tile_app"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/slot1"
                        layout="@layout/tile_app"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/slot2"
                        layout="@layout/tile_app"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/slot3"
                        layout="@layout/tile_app"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- اليمين: التحكم بالصوت -->
            <LinearLayout
                android:id="@+id/volumeColumn"
                android:layout_width="76dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="8dp">

                <Button
                    android:id="@+id/volUp"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_round_alt"
                    android:contentDescription="رفع الصوت"
                    android:stateListAnimator="@null"
                    android:text="+"
                    android:textColor="?attr/lText"
                    android:textSize="26sp" />

                <com.example.launcher.VolumeBar
                    android:id="@+id/volBar"
                    android:layout_width="44dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/volDown"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_round_alt"
                    android:contentDescription="خفض الصوت"
                    android:stateListAnimator="@null"
                    android:text="−"
                    android:textColor="?attr/lText"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/volText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/lTextDim"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/drawerHandle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="كل التطبيقات · اسحب للأعلى أو اضغط"
            android:textColor="?attr/lTextDim"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- درج التطبيقات: لوحة داخل نفس الشاشة عشان تفتح بسرعة -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/lBg"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/drawerClose"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_tile"
                android:minWidth="120dp"
                android:stateListAnimator="@null"
                android:text="إغلاق"
                android:textColor="?attr/lText"
                android:textSize="18sp" />

            <Button
                android:id="@+id/drawerDiag"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_tile"
                android:minWidth="110dp"
                android:stateListAnimator="@null"
                android:text="تشخيص"
                android:textColor="?attr/lText"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/drawerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:textColor="?attr/lText"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <GridView
            android:id="@+id/drawerGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:numColumns="6"
            android:verticalSpacing="6dp" />
    </LinearLayout>

    <!-- شاشة الانتظار -->
    <FrameLayout
        android:id="@+id/idleOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/idleClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="96sp" />

            <TextView
                android:id="@+id/idlePrayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/idleNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:textColor="#475569"
            android:textSize="16sp" />
    </FrameLayout>
</FrameLayout>
